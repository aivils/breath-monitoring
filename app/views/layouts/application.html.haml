!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta(name="viewport" content="width=device-width, initial-scale=1")

    -# PWA
    %link{ rel: "manifest", href: pwa_manifest_path }
    %meta{ name: "theme-color", content: "#ff6300" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }

    -# Browser favicon
    %link{ rel: "icon", type: "image/svg+xml", href: image_path("pwa/icon.svg") }

    -# iOS
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "apple-mobile-web-app-status-bar-style", content: "default" }
    %link{ rel: "apple-touch-icon", href: image_path("pwa/icon-192.png") }

    %title Breath Rate Monitor
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload'
    = stylesheet_link_tag 'https://unpkg.com/tachyons@4.10.0/css/tachyons.min.css'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
  %body.w-100.sans-serif
    %main
      = render 'layouts/header'
      = render 'layouts/flash'
      = yield
